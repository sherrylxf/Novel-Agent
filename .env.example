# ============================================
# 环境变量配置模板（请勿填写真实 Key 到此文件）
# ============================================
# 使用方法：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 在 .env 中填写你自己的 API Key 和密码
# 3. 不要提交 .env 到 Git（.gitignore 已忽略）
# ============================================

# LLM API 配置（必填，否则 Chat 功能不可用）
# DeepSeek: https://platform.deepseek.com/api_keys
OPENAI_API_KEY=sk-45e14e100bee45b9b935e65fca433e26
OPENAI_BASE_URL=https://api.deepseek.com

# 若使用 OpenAI：OPENAI_BASE_URL=https://api.openai.com
# 若使用通义千问：OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# PostgreSQL（业务表 + pgvector 向量表，同库 novel_vector）
SPRING_DATASOURCE_POSTGRESQL_URL=jdbc:postgresql://127.0.0.1:15432/novel_vector
SPRING_DATASOURCE_POSTGRESQL_USERNAME=postgres
SPRING_DATASOURCE_POSTGRESQL_PASSWORD=your-postgres-password

# Neo4j知识图谱配置
SPRING_NEO4J_URI=bolt://localhost:7687
SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
SPRING_NEO4J_AUTHENTICATION_PASSWORD=your-neo4j-password
